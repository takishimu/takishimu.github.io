        let synopsis2023 = `
ボックス検査という大仕事を任された主人公。<BR>
検査要項を満たして検査をしようとしたところ、ボックスの内容が『雑魚メス調教プログラム』だった。<BR>
驚いている間にも媚薬を注入されたりして勝手に調教は進んでいってしまう。<BR>
乳首・クリトリス・おまんこと順々に媚薬を追加されたり責められたりして雑魚メスに相応しいよわよわボディに作り変えられていく。
        `;
        let synopsis2024 = synopsis2023;
        let synopsis2025 = synopsis2023;
        let synopsis2026 = synopsis2023;

        let currentManga = null;
        let currentPage = 0;

        const monthNames = ["1月","2月","3月","4月","5月","6月","7月","8月","9月","10月","11月","12月"];

        function renderYearList(year) {
            const container = document.getElementById('year' + year + 'Content');
            container.innerHTML = '';

            // あらすじ表示
            let synopsis = '';
            if (year === "2023") synopsis = synopsis2023;
            else if (year === "2024") synopsis = synopsis2024;
            else if (year === "2025") synopsis = synopsis2025;
            else if (year === "2026") synopsis = synopsis2026;

            if (synopsis) {
                const synopsisDiv = document.createElement('div');
                synopsisDiv.style.cssText = 'padding: 15px 12px; color:#555; background:#f9f0f9; border-radius:8px; margin-bottom:15px; border-left:5px solid #8b008b;';
                synopsisDiv.innerHTML = synopsis;
                container.appendChild(synopsisDiv);
            }

            // 月一覧
            let startMonth = (year === "2023") ? 2 : 1;
            for (let m = startMonth; m <= 12; m++) {
                const monthStr = m.toString().padStart(2, '0');
                const monthHeader = document.createElement('div');
                monthHeader.className = 'month-header';
                monthHeader.innerHTML = `${monthNames[m-1]} <span>→</span>`;
                monthHeader.onclick = () => showPasswordForYearMonth(year, monthStr);
                container.appendChild(monthHeader);
            }
        }

        function toggleYear(year) {
            const content = document.getElementById('year' + year + 'Content');
            const arrow = document.getElementById('arrow' + year);
            if (content) {
                content.classList.toggle('active');
                arrow.textContent = content.classList.contains('active') ? '▲' : '▼';
            }
        }

        // ★★★ ここを修正 ★★★
        function showPasswordForYearMonth(year, month) {
            // mangaListから該当する漫画を探す
            currentManga = mangaList.find(m => m.year === year && m.month === month);
            
            // まだ登録されていない月は仮データ
            if (!currentManga) {
                currentManga = {
                    title: `${year}年${month}月号`,
                    password: "8nptp9et",
                    pages: []   // 後で画像を追加予定
                };
            }
            openPasswordScreen();
        }

        function openPasswordScreen() {
            document.getElementById('passwordTitle').innerHTML = 
                `${currentManga.title}<br>を表示するには<br>パスワードを入力してください`;
            document.getElementById('passwordScreen').style.display = 'flex';
            document.getElementById('passwordInput').value = '';
            document.getElementById('passwordError').textContent = '';
        }

        function checkPassword() {
            const input = document.getElementById('passwordInput').value;
            if (input === currentManga.password) {
                document.getElementById('passwordScreen').style.display = 'none';
                loadManga();
            } else {
                document.getElementById('passwordError').textContent = "パスワードが違います";
            }
        }

        function loadManga() {
            currentPage = 0;
            document.getElementById('currentTitle').textContent = currentManga.title;
            showCurrentPage();
        }
        function showCurrentPage() {
            const viewer = document.getElementById('mangaViewer');
            if (!currentManga.pages || currentManga.pages.length === 0) {
                viewer.innerHTML = `<p style="color:white; padding:100px 20px;">この月の漫画はまだ準備中です。</p>`;
                return;
            }

            let buttons = '';

            // 最終ページ以外なら「次ページ」を左側に
            if (currentPage < currentManga.pages.length - 1) {
                buttons += `<button onclick="nextPage()">次ページ</button>`;
            } else {
                // 最終ページは右寄せにするために空の要素を入れる
                buttons += `<span style="flex:1;"></span>`;
            }

            // 1ページ目以外なら「前ページ」を右側に
            if (currentPage > 0) {
                buttons += `<button onclick="prevPage()">前ページ</button>`;
            }

            viewer.innerHTML = `
                <img src="${currentManga.pages[currentPage]}" class="manga-page" alt="ページ ${currentPage + 1}">
                <div class="page-info">${currentPage + 1} / ${currentManga.pages.length}</div>
                <div class="nav-buttons">
                    ${buttons}
                </div>
            `;
        }
        function nextPage() {
            if (currentPage < currentManga.pages.length - 1) {
                currentPage++;
                showCurrentPage();
            }
        }

        function prevPage() {
            if (currentPage > 0) {
                currentPage--;
                showCurrentPage();
            }
        }

        // 初期化
        window.onload = function() {
            renderYearList('2023');
            renderYearList('2024');
            renderYearList('2025');
            renderYearList('2026');
            
            document.getElementById('year2023Content').classList.remove('active');
            document.getElementById('year2024Content').classList.remove('active');
            document.getElementById('year2025Content').classList.remove('active');
            document.getElementById('year2026Content').classList.remove('active');
            
            document.getElementById('arrow2023').textContent = '▼';
            document.getElementById('arrow2024').textContent = '▼';
            document.getElementById('arrow2025').textContent = '▼';
            document.getElementById('arrow2026').textContent = '▼';
        };
